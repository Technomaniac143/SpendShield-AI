ENVIRONMENT=development
DATABASE_URL=sqlite:///./spendshield.db
AUTH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_DOCUMENT_BYTES=26214400
MAX_INGESTION_BYTES=104857600
INGESTION_WORKER_MODE=background
CORS_ORIGINS=http://localhost:5173
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=spendshield-evidence

# Hyperledger Fabric Configuration
FABRIC_GATEWAY_URL=grpc://localhost:7051
FABRIC_CHANNEL=spendchannel
FABRIC_CHAINCODE=spendshield
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_HELPER_PATH=fabric/client/gateway.js
EVIDENCE_LEDGER_BACKEND=database

# Market Intelligence Configuration
MARKET_INTELLIGENCE_ENABLED=true
MARKET_INTELLIGENCE_MODE=mock
MARKET_COLLECTION_TIMEOUT=15
MARKET_COLLECTION_MAX_RESULTS=25
MARKET_COLLECTION_RATE_LIMIT=1.0
MARKET_USER_AGENT=SpendShield-MarketIntelligence/1.0
RUN_MARKET_LIVE=0
